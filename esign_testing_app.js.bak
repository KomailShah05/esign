app.use(bodyParser.json());
app.use(cors());

const routes = require("./routes");

router.use('/', routes);

app.post('/api/sign/new/:mfgId', function(req, res){

    let post = req.body;
    
    let mfgId = req.params.mfgId;
    let mfg = manufacturer[mfgId];
    let lineItems = [];

    let fields = {
        date: '3/29/2020',
        buyer: 'Bruce Lee',
    };

    let document_fields = [

        [
            {
                "api_id":"ef1cef10_1",
                "name":"date",
                "type":"text-merge",
                "x":76,
                "y":56,
                "width":200,
                "height":16,
                "required":false,
                "signer":"sender",
                "page":1
            },

            {
                "api_id":"ef1cef10_33",
                "name":"Customer",
                "type":"signature",
                "x":48,
                "y":688,
                "width":220,
                "height":16,
                "required":true,
                "signer":0,
                "page":1
            }
        ],

        [
            {
                "api_id":"ef1cef10_2",
                "name":"buyer",
                "type":"text-merge",
                "x":75,
                "y":103,
                "width":250,
                "height":16,
                "required":false,
                "signer":"sender",
                "page":2
            }
        ]

    ];
    
    let opts = {
        test_mode: 1,
        clientId: 'dad04e2f07e609c35a9ac66fba86444a',
        file_url: [
            'https://carport.com/api/documents/_PSG-ORDER-FORM-190801-2BD.pdf',
            'https://carport.com/api/documents/waivers/Generic-Roof-Waiver.pdf'
        ],
        subject: 'Caport Purchase Agreement',
        message: 'Please sign this agreement to complete your purchase!',
        signers: [
          {
            email_address: 'deankevin@email.com', // ToDo: don't hard-code this!
            name: 'Kevin Dean'
          }
        ],
        custom_fields: fields, // values for fields
        form_fields_per_document: document_fields // field definitions
    };
    
    
    hellosign.signatureRequest.createEmbedded(opts)
        .then(function(response){
            data = response;
            let signatureId = response.signature_request.signatures[0].signature_id;
            return hellosign.embedded.getSignUrl(signatureId);
        })
        .then(function(response){
            data = response.embedded;
        })
        .catch(function(err){
            data = err;
        })
        .finally(function(){
            res.type('json');
            res.json(data);
        });
    

});

app.use('/api/sign', router);

app.listen(port, "127.0.0.1", () => console.log(`eSign service running on ${port}`));